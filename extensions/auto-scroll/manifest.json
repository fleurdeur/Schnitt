{
  "schema": 1,
  "id": "auto-scroll",
  "name": "Auto Scroll",
  "version": "1.2.0",
  "author": "fleurdeur",
  "description": "Keeps the timeline on the layer that is playing. Follow the bottom layer first, reveal layers from bottom to top, skip pinned top layers, and ease between rows without changing playback.",
  "category": "behavior",
  "capabilities": [
    "timeline.follow"
  ],
  "properties": [
    {
      "id": "enabled",
      "label": "Follow during playback",
      "type": "toggle",
      "default": true
    },
    {
      "id": "mode",
      "label": "Follow",
      "type": "choice",
      "options": [
        "Playing layer",
        "Selected layer",
        "Scroll through layers"
      ],
      "values": [
        "playing",
        "selected",
        "sweep"
      ],
      "default": "playing"
    },
    {
      "id": "start",
      "label": "Start from",
      "type": "choice",
      "options": [
        "Bottom layer",
        "Top layer"
      ],
      "values": [
        "bottom",
        "top"
      ],
      "default": "bottom"
    },
    {
      "id": "skipTop",
      "label": "Skip layers at top",
      "type": "slider",
      "default": "1",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "includeHidden",
      "label": "Include hidden layers",
      "type": "toggle",
      "default": false
    },
    {
      "id": "snap",
      "label": "Snap layer to centre",
      "type": "toggle",
      "default": true
    },
    {
      "id": "speed",
      "label": "Scroll speed",
      "type": "slider",
      "default": 1.0,
      "min": 0.25,
      "max": 3.0,
      "step": 0.05
    },
    {
      "id": "smoothness",
      "label": "Smoothing time",
      "type": "slider",
      "default": 260,
      "min": 80,
      "max": 1200,
      "step": 20
    }
  ]
}
