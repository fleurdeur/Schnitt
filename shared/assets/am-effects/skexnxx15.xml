<?xml version='1.0' encoding='UTF-8' ?>
<effect id="com.alightcreative.effects.skexnxx15" name="V Transform" desc="A compact transform with position, scale, rotation, skew and invert controls." category="transform">
    <params>
        <texture id="inputImg" srcType="content" />
<spinner id="posx" label="Shift X" default="0" min="-8192" max="8192" step="0.5" />
<spinner id="posy" label="Shift Y" default="0" min="-8192" max="8192" step="0.5" />
<spinner id="posz" label="Scale" default="1" min="0.001" max="30" step="0.005" />
<spinner id="angle" label="Rotate" default="0" min="-3600" max="3600" step="0.5" type="angle" />
<spinner id="skew" label="Skew" default="0" min="-90" max="90" step="0.5" type="angle" />
<spinner id="amp" label="Master Amount" default="1" min="0" max="2" step="0.01" />
<switch id="xinv" label="Invert X" default="false" />
<switch id="yinv" label="Invert Y" default="false" />
<switch id="zinv" label="Invert Scale" default="false" />
<switch id="ainv" label="Invert Angle" default="false" />
    </params>
</effect>
